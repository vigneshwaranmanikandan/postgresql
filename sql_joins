--bonus tasks

select c.course_id, c.course_name, count(student_id) as total_students
from student_data s
join course_data c
on s.course_id = c.course_id
group by c.course_id

select c.course_id, c.course_name, count(student_id) as total_students
from student_data s
join course_data c
on s.course_id = c.course_id
group by c.course_id
having count(s.student_id) = (
	select count(student_id) as total_students
	from student_data s
	join course_data c
	on s.course_id = c.course_id
	group by c.course_id
	order by total_students desc
	limit 1
)

select s.student_id, upper(s.student_name), c.course_name
from student_data s
join course_data c
on s.course_id = c.course_id;

select s.student_id, s.student_name, c.course_name
