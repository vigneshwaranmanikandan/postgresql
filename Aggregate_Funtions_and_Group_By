---Aggregation---
select ename,sal from emp
where ename = 'SMITH';

select ename from emp
where job = 'CLERK';

select ename, sal from emp
where job = 'SALESMAN';

select empno, ename, job, mgr, hiredate, sal, comm, deptno from emp
where sal > 2000;

select empno, ename, job, mgr, hiredate, sal, comm, deptno from emp
where ename = 'JONES';

select empno, ename, job, mgr, hiredate, sal, comm, deptno from emp
where hiredate > '1981-01-01';

select ename, sal from emp
where sal > 1200;

select empno from emp
where deptno = 30;

select ename, hiredate from emp
where extract(year from hiredate) < '1981';

select empno, ename, job, mgr, hiredate, sal, comm, deptno from emp
where job = 'MANAGER';

select ename, sal from emp
where comm = 1400;

select empno, ename, job, mgr, hiredate, sal, comm, deptno from emp
where comm > sal;

select empno from emp
where extract(year from hiredate) < 1987;

select empno, ename, job, mgr, hiredate, sal, comm, deptno from emp
where job = 'ANALYST';

select empno, ename, job, mgr, hiredate, sal, comm, deptno from emp
where sal > 2000;

select ename, sal from emp
where sal = (select max(sal) from emp);

select ename, sal from emp
where sal = (select min(sal) from emp);

select ename, hiredate from emp
where hiredate = (select min(hiredate) from emp);

select ename, hiredate from emp
where hiredate = (select max(hiredate) from emp);

select ename, comm from emp
where comm = (select min(comm) from emp);

select ename, comm from emp
where comm = (select max(comm) from emp);

select empno, ename, job, mgr, hiredate, sal, comm, deptno from emp
where empno = (select max(empno) from emp);

select empno, ename, job, mgr, hiredate, sal, comm, deptno from emp
order by hiredate
limit 1;

select empno, ename, job, mgr, hiredate, sal, comm, deptno from emp
where sal = (select min(sal) from emp);

select ename, sal from emp
where job != 'SALESMAN' and sal > (select max(sal) from emp where job = 'SALESMAN');

---Group By---

select job, count(empno) as "No. of emp" from emp
group by job
having job != 'PRESIDENT';

select job, sum(sal) as "Tot sal" from emp
group by job;

select job, count(empno) as "No. of emp" from emp
group by job
having job = 'MANAGER';

select avg(sal), deptno from emp
group by deptno
having deptno != 20;

select count(empno), job from emp
where ename like '%A%'
group by job;

SELECT deptno, COUNT(*) AS employee_count, AVG(sal) AS average_salary
FROM emp
WHERE sal > 2000
GROUP BY deptno;

SELECT deptno, SUM(sal) AS total_salary, COUNT(*) AS salesman_count
FROM emp
WHERE job = 'SALESMAN'
GROUP BY deptno;

SELECT job, COUNT(*) AS employee_count, MAX(sal) AS maximum_salary
FROM emp
GROUP BY job;

SELECT deptno, MAX(sal) AS maximum_salary
FROM emp
GROUP BY deptno;

SELECT sal, COUNT(*) AS occurrences
FROM emp
GROUP BY sal;
